[% WRAPPER 'wrapper-staff-tool-plugin.inc' method='configure' plugin_title='Simple Statistics: SQL reports' %]

[% IF error %]
<div class="alert alert-warning">[% error | html %]</div>
[% END %]

[% IF default_language %]
<div class="alert alert-info">
    Default staff interface language:
    <strong>[% default_language.description | html %] ([% default_language.code | html %])</strong>.
    Automatic report installs use this language.
</div>
[% END %]

[% IF has_available %]
<form method="post" style="margin-bottom:1em">
    <input type="hidden" name="class" value="[% CLASS | html %]"/>
    <input type="hidden" name="method" value="[% METHOD | html %]"/>
    <input type="hidden" name="deploy_all" value="1"/>
    [% INCLUDE 'csrf-token.inc' %]
    <input type="submit" class="btn btn-primary" value="Deploy all available"/>
</form>
[% END %]

<table id="simplestatistics-reports" class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Group</th>
            <th>Subgroup</th>
            <th>Public</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    [% FOREACH r IN reports %]
        <tr[% UNLESS r.deployed %] style="background-color:#f2dede;"[% END %]>
            <td>
                [% r.name | html %]
                [% IF r.masked %] <span class="label label-default">masked</span>[% END %]
            </td>
            <td>[% r.description | html %]</td>
            <td>[% r.group | html %]</td>
            <td>[% r.subgroup | html %]</td>
            <td>[% IF r.public %]Yes[% ELSE %]No[% END %]</td>
            <td>
                [% IF r.deployed %]
                    <span class="label label-success">Deployed [% r.language | html %]</span>
                    <a class="btn btn-mini" href="/cgi-bin/koha/reports/guided_reports.pl?op=edit_form&amp;id=[% r.saved_sql_id | html %]">edit #[% r.saved_sql_id | html %]</a>
                    [% IF r.differs %]
                        <span class="label label-warning">differs</span>
                        <form method="post" style="display:inline">
                            <input type="hidden" name="class" value="[% CLASS | html %]"/>
                            <input type="hidden" name="method" value="[% METHOD | html %]"/>
                            <input type="hidden" name="update" value="1"/>
                            <input type="hidden" name="code" value="[% r.code | html %]"/>
                            [% INCLUDE 'csrf-token.inc' %]
                            <input type="submit" class="btn btn-default btn-sm" value="Update to plugin version"/>
                        </form>
                    [% END %]
                    <div class="hint">deployed [% r.deployed_on | html %]</div>
                [% ELSE %]
                <form method="post" style="display:inline">
                    <input type="hidden" name="class" value="[% CLASS | html %]"/>
                    <input type="hidden" name="method" value="[% METHOD | html %]"/>
                    <input type="hidden" name="deploy" value="1"/>
                    <input type="hidden" name="code" value="[% r.code | html %]"/>
                    [% INCLUDE 'csrf-token.inc' %]
                    <input type="submit" class="btn btn-default btn-sm" value="Deploy"/>
                </form>
                [% END %]
            </td>
        </tr>
    [% END %]
    </tbody>
</table>

<p class="hint">
    Rows highlighted in red are not deployed in Koha's SQL reports
    (for example after a librarian deleted them). Public reports are never
    deployed automatically &mdash; use the Deploy button. "differs" means the
    deployed report has been edited and no longer matches the plugin version.
</p>

[% END %]
